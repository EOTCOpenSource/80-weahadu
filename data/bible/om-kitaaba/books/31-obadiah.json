      }
     ]
    },
    {
     "n": 4,
     "t": "Ati akka joobiraa yoo ol kaate iyyuu, mann'ee kees urjoota gidduutti yoo ijaarratte iyyuu, ani achii gad sin buusa? jedhee dubbateera.",
     "alt": "፬",
     "lines": [
