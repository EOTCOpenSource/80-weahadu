      }
     ]
    },
    {
     "n": 8,
     "t": "Nanawwee garuu tinfa lolaatiin raawwatee in balleessa, diinota isaas ari'ee dukkanatti in galcha.",
     "alt": "፰",
     "lines": [
      {
       "style": "p",
       "t": "Nanawwee garuu tinfa lolaatiin"
      },
