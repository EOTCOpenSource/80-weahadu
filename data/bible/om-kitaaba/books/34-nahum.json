      }
     ]
    },
    {
     "n": 11,
     "t": "Yaa Nanawwe, inni Waaqayyo irratti koratu, inni wanta jal'aa mari'atus si keessaa ka'e.",
     "alt": "፲፩",
     "lines": [
      {
       "style": "p",
       "t": "Yaa Nanawwe, inni Waaqayyo irratti koratu,"
